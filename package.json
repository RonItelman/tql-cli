{
  "name": "@trustquery/trace",
  "description": "TrustQuery Trace - Trace data disambiguation conversations with versioned semantic annotations",
  "version": "0.3.1",
  "author": "Ron Itelman",
  "bin": {
    "tql": "bin/run.js"
  },
  "bugs": "https://github.com/RonItelman/trustquery-trace/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/RonItelman/trustquery-trace",
  "keywords": [
    "tql",
    "trustquery",
    "trace",
    "data-disambiguation",
    "semantic-annotations",
    "data-quality",
    "ambiguity",
    "csv",
    "data-lineage",
    "conversation-trace",
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "tql",
    "dirname": "tql",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RonItelman/trustquery-trace.git"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "demo": "npm run build && node bin/run.js example",
    "example": "npm run build && node bin/run.js example",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
